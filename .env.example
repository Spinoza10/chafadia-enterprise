# Frontend build-time variables (copy to .env.local). Only PUBLIC values belong here:
# everything in a VITE_ variable is visible in the browser.

# API origin. Leave empty when the API is served on the same domain under /api (recommended).
VITE_API_URL=

# Google Maps browser key (Places autocomplete at checkout). Optional: without it, customers
# type their address / use "my location", and admins still get map previews and directions links.
# In Google Cloud Console restrict it to: HTTP referrers = your domain(s); APIs = Maps JavaScript API + Places API.
VITE_GOOGLE_MAPS_API_KEY=
