# Copy to .env (npm run db:setup does this for you and fills the database + JWT values).
# Never commit .env. Every secret lives here, never in code or in the frontend.

NODE_ENV=development
PORT=4000
# 127.0.0.1 = the API is not reachable from the network, only via the Vite proxy / nginx on this machine.
HOST=127.0.0.1

# WhatsApp receipts: mock (prints to the console; numbers ending in 0000 act as "not on WhatsApp"),
# cloud (Meta WhatsApp Cloud API) or off. See README "WhatsApp receipts".
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_RECEIPT_TEMPLATE=order_receipt
# Optional approved template sent at sign-up to check the number is on WhatsApp (body: {{1}} = name).
WHATSAPP_WELCOME_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Messages/broadcasts from the Customers screen outside the 24 h reply window. Body: "Hello {{1}}, {{2}}"
WHATSAPP_MESSAGE_TEMPLATE=customer_message
# Password reset for phone-only accounts. Body: "Hello {{1}}, use this link within 30 minutes to reset your CHAFADIA password: {{2}}"
WHATSAPP_RESET_TEMPLATE=password_reset

# Runtime role (least privilege) and owner role (migrations only). Filled by `npm run db:setup`.
DATABASE_URL=postgresql://chafadia_enterprise_app:CHANGE_ME@localhost:5432/chafadia_enterprise
MIGRATION_DATABASE_URL=postgresql://chafadia_enterprise_owner:CHANGE_ME@localhost:5432/chafadia_enterprise
APP_DB_ROLE=chafadia_enterprise_app

# At least 32 random characters. db:setup generates one.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=14

# Where the React app runs (used in emails, QR codes and payment redirects) and allowed CORS origins.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Set to true when running behind a reverse proxy (nginx, Render, Railway...) so client IPs are correct.
TRUST_PROXY=false

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# How online orders are paid:
#   manual  = customer sends MoMo / Orange Money to the shop's numbers (Settings) and uploads a screenshot
#             that admins approve (default; no payment provider account needed)
#   gateway = automatic payment through PAYMENT_PROVIDER below
ONLINE_PAYMENT_MODE=manual
# Payment screenshots are stored here, outside the public uploads folder. Back this folder up.
PROOF_DIR=./private_uploads/payment-proofs

# Payments: "mock" (development only, refused in production) or "notchpay".
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret-change-me
PAYMENT_TIMEOUT_MINUTES=15
# Notch Pay - use the TEST keys until go-live. Webhook URL: https://<your-api>/api/payments/webhook/notchpay
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_PRIVATE_KEY=
NOTCHPAY_WEBHOOK_HASH=
NOTCHPAY_API_URL=https://api.notchpay.co

# Email (receipts, password reset, alerts). Leave SMTP_HOST empty to print emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CHAFADIA ENTERPRISE <no-reply@chafadia.com>

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RUN_JOBS=true
